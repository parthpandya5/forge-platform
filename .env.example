# Shared
FORGE_ENV=development
FORGE_LOG_LEVEL=info
FORGE_DATABASE_URL=postgres://forge:forge@localhost:55432/forge?sslmode=disable
FORGE_POSTGRES_PORT=55432
FORGE_MIGRATIONS_PATH=migrations

# API
FORGE_API_ADDR=:8080
FORGE_LOCAL_USER_EMAIL=developer@forge.local
FORGE_LOCAL_USER_NAME=Local Developer
# Development-only example. Generate a new 32-byte base64 value for shared environments.
FORGE_ENCRYPTION_KEY=Zm9yZ2UtZGV2ZWxvcG1lbnQtb25seS1rZXktMDAwMDA=
FORGE_GITHUB_WEBHOOK_SECRET=
FORGE_CORS_ORIGIN=http://localhost:3000

# Worker
FORGE_WORKER_ID=
FORGE_WORKER_METRICS_ADDR=:9090
FORGE_WORKER_CONCURRENCY=2
FORGE_JOB_LEASE=30s
FORGE_JOB_HEARTBEAT=10s
FORGE_JOB_MAX_ATTEMPTS=3
FORGE_CLONE_TIMEOUT=2m
FORGE_BUILD_TIMEOUT=15m
FORGE_ROLLOUT_TIMEOUT=5m
FORGE_HEALTH_INTERVAL=30s
FORGE_DOCKER_HOST=
FORGE_IMAGE_REPOSITORY=forge
FORGE_REGISTRY=localhost:5001
FORGE_PUSH_IMAGES=true

# Kubernetes and routing
FORGE_KUBECONFIG=
FORGE_KUBE_NAMESPACE=forge-apps
FORGE_INGRESS_CLASS=nginx
FORGE_BASE_DOMAIN=localhost
FORGE_PULL_POLICY=Always
FORGE_CONTAINER_KUBECONFIG=./deploy/kubernetes/generated/worker-kubeconfig

# Web (browser-visible)
NEXT_PUBLIC_FORGE_API_URL=http://localhost:8080
